{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "Service": "ec2.amazonaws.com"
        },
        "Action": "sts:AssumeRole"
      },
      {
        "Effect": "Allow",
        "Principal": {
          "Service": "ecs-tasks.amazonaws.com"
        },
        "Action": "sts:AssumeRole"
      },
      {
        "Effect": "Allow",
        "Principal": {
          "Service": "eks.amazonaws.com"
        },
        "Action": "sts:AssumeRole"
      },
      {
        "Sid": "AllowEc2AssumeRole",
        "Effect": "Allow",
        "Principal": {
          "AWS": [
            "arn:aws:iam::<ACCOUNT_ID>:user/<USER_NAME>",
            "arn:aws:iam::<ACCOUNT_ID>:role/<ROLE_NAME>"
          ]
        },
        "Action": "sts:AssumeRole"
      }
    ]
}
